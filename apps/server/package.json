{
  "name": "@partyverse/server",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@azure/web-pubsub": "^1.2.0",
    "@azure/web-pubsub-express": "^1.1.0",
    "@fastify/express": "^4.0.9",
    "@partyverse/shared": "workspace:*",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "xstate": "^5.33.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  }
}
