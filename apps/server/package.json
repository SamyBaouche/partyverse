{
  "name": "@partyverse/server",
  "version": "0.0.0",
  "private": true,
  "dependencies": {
    "@partyverse/shared": "workspace:*",
    "fastify": "^5.12.8",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
